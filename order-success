<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Order submitted | Shakil's Choice</title>
<style>
:root{--green:#126b50;--deep:#103d30;--ink:#17231d;--muted:#68756d;--bg:#f5f8f5;--line:#e0e9e1;--gold:#f4c95d}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,sans-serif;min-height:100vh;display:flex;flex-direction:column}
button{font:inherit;cursor:pointer;border:0;border-radius:11px;padding:13px 18px;font-weight:800;transition:.15s}button:hover{transform:translateY(-1px)}.primary{background:var(--green);color:#fff}.soft{background:#e8f2eb;color:var(--green)}
header{background:#ffffffed;backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.nav{max-width:1100px;margin:auto;padding:16px;display:flex;align-items:center;justify-content:space-between;gap:12px}.logo{display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--green);font-size:24px;font-weight:900}.logo-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:var(--green);color:#fff;box-shadow:0 5px 14px #126b5030}.nav a:last-child{color:var(--ink);text-decoration:none;font-weight:700;font-size:14px}
main{width:min(720px,calc(100% - 30px));margin:auto;padding:40px 0}.success-card{background:#fff;border:1px solid var(--line);border-radius:28px;padding:clamp(26px,6vw,55px);text-align:center;box-shadow:0 22px 60px #173d2512;animation:cardIn .5s ease both}.check-wrap{width:94px;height:94px;margin:0 auto 22px;border-radius:50%;background:#e6f2e8;display:grid;place-items:center;animation:pop .55s cubic-bezier(.2,.8,.2,1) both}.check{width:55px;height:55px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-size:30px;font-weight:900;box-shadow:0 9px 24px #126b5030;animation:checkIn .65s .18s ease both}.eyebrow{font-size:12px;font-weight:900;letter-spacing:2px;color:var(--green)}h1{font-size:clamp(32px,7vw,48px);line-height:1.05;letter-spacing:-1.5px;margin:10px 0 14px}p{line-height:1.65;color:var(--muted)}.ref{display:inline-block;margin:12px 0 18px;padding:12px 18px;border-radius:12px;background:#f1f6f2;color:var(--deep);font-weight:900;font-size:18px;letter-spacing:.5px}.status-box{margin:20px auto;padding:16px;border:1px solid #dce8dd;border-radius:16px;background:#f7faf7;max-width:520px}.status-pill{display:inline-block;padding:6px 12px;border-radius:99px;background:#e8f2eb;color:var(--green);font-size:13px;font-weight:900}.buttons{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:25px}.small{font-size:12px;color:var(--muted);margin-top:22px}footer{max-width:1100px;width:100%;margin:auto;padding:18px 16px 28px;color:var(--muted);font-size:13px;text-align:center}
@keyframes pop{0%{transform:scale(.45);opacity:0}70%{transform:scale(1.08);opacity:1}100%{transform:scale(1)}}@keyframes checkIn{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.12);opacity:1}100%{transform:scale(1)}}@keyframes cardIn{0%{transform:translateY(15px);opacity:0}100%{transform:translateY(0);opacity:1}}@media(max-width:520px){.nav{flex-wrap:wrap}.nav a:last-child{display:none}.buttons button{width:100%}}
</style>
</head>
<body>
<header><div class="nav"><a class="logo" href="index.html"><span class="logo-mark">S</span> Shakil's Choice</a><a href="profile.html">My Profile</a></div></header>
<main>
<section class="success-card" aria-live="polite">
  <div class="check-wrap"><div class="check">✓</div></div>
  <div class="eyebrow">ORDER SUBMITTED</div>
  <h1>Thank you! Your order was submitted successfully.</h1>
  <p>Your order has been saved to your account. Keep your order number for reference.</p>
  <div id="orderRef" class="ref">Loading order number…</div>
  <div class="status-box">
    <div class="status-pill" id="status">Checking order status…</div>
    <p id="statusText">You can see the latest delivery and payment status anytime from <strong>My Profile → My orders & tracking</strong>.</p>
  </div>
  <div class="buttons">
    <button class="primary" onclick="location.href='profile.html'">View My Profile & Track Order</button>
    <button class="soft" onclick="location.href='index.html'">Continue Shopping</button>
  </div>
  <p class="small">If the payment method is bKash, Nagad or Rocket, the order may remain pending until the store verifies the transaction.</p>
</section>
</main>
<footer>© <span id="year"></span> Shakil's Choice · Developer: MD SHAKIL SARKAR</footer>
<script src="config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const sb=window.supabase.createClient(CONFIG.supabaseUrl,CONFIG.supabaseAnonKey);
const ref=new URLSearchParams(location.search).get('ref');
const refEl=document.getElementById('orderRef'),statusEl=document.getElementById('status'),textEl=document.getElementById('statusText');
document.getElementById('year').textContent=new Date().getFullYear();
function statusText(s){return({pending:'Order pending',awaiting_payment_verification:'MFS awaiting verification',paid:'Payment verified',payment_rejected:'Payment rejected',cod_confirmed:'COD order confirmed',dispatched:'Dispatched',delivered:'Delivered',cancelled:'Cancelled'})[s]||s||'Order submitted';}
async function load(){
  if(!ref){refEl.textContent='Order submitted';statusEl.textContent='Submitted successfully';return;}
  refEl.textContent=ref;
  const {data:{session}}=await sb.auth.getSession();
  if(!session){statusEl.textContent='Order submitted';return;}
  const {data,error}=await sb.from('orders').select('order_ref,status,payment_status').eq('order_ref',ref).eq('customer_id',session.user.id).maybeSingle();
  if(error||!data){statusEl.textContent='Order submitted';return;}
  statusEl.textContent=statusText(data.status);
  textEl.innerHTML='You can see the latest delivery and payment status anytime from <strong>My Profile → My orders & tracking</strong>.'+(data.payment_status?'<br><span style="font-size:12px;color:#68756d">Payment: '+String(data.payment_status).replaceAll('_',' ')+'</span>':'');
}
load();
</script>
</body>
</html>
